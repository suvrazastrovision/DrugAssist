# Used for embeddings and optional cited answer writing.
OPENAI_API_KEY=
# Optional: openFDA permits limited keyless access.
FDA_API_KEY=

# Optional metadata-only Langfuse Cloud tracing (install the observability extra).
DRUGASSIST_OBSERVABILITY_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Streamlit connects to the local FastAPI backend.
DRUGASSIST_API_URL=http://127.0.0.1:8000
DRUGASSIST_REQUEST_TIMEOUT=120
# Optional: override the separate authentication database path.
# DRUGASSIST_AUTH_DB=data/auth/users.sqlite3
